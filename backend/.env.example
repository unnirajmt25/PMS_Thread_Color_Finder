# Copy to .env and fill in. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# SQL Server connection. Local dev target is the machine's SQL Server
# Express instance (Windows Authentication — no password needed).
SQL_SERVER_HOST=.\SQLEXPRESS
SQL_SERVER_PORT=
SQL_SERVER_DATABASE=IdyThreadIntelligence
SQL_SERVER_USER=
SQL_SERVER_PASSWORD=
# Set to "yes" to use Windows Authentication (Trusted_Connection) instead
# of SQL_SERVER_USER/PASSWORD. Default for local dev.
SQL_SERVER_TRUSTED_CONNECTION=yes
SQL_SERVER_DRIVER=ODBC Driver 18 for SQL Server
# Local Express instance uses a self-signed cert — required for Driver 18.
SQL_SERVER_TRUST_SERVER_CERTIFICATE=yes

# Composed automatically by config/settings.py if left blank; set explicitly
# to override.
DATABASE_URL=
