.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.env

# Profiler output is regenerated by scripts/profile_workbooks.py — not
# committed since it's derived from data/ files that may change.
/reports/*.json
/reports/*.md

# Untrusted uploads never get committed.
/data/incoming/*
/data/processed/*
/data/quarantine/*
!/data/incoming/.gitkeep
!/data/processed/.gitkeep
!/data/quarantine/.gitkeep
